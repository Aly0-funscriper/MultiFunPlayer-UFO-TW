<UserControl x:Class="MultiFunPlayer.OutputTarget.Views.UfoTwBleOutputTarget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:material="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:s="https://github.com/canton7/Stylet"
             d:DesignHeight="450"
             d:DesignWidth="800"
             x:ClassModifier="internal"
             mc:Ignorable="d">
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="UpdateContextTemplates.xaml"/>
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>

    <Expander Style="{StaticResource MaterialDesignToolBarExpander}"
              material:ExpanderAssist.HorizontalHeaderPadding="0 0 6 0"
              Background="{DynamicResource MaterialDesignToolBarBackground}"
              IsExpanded="{Binding DataContext.ContentVisible, RelativeSource={RelativeSource FindAncestor, AncestorLevel=2, AncestorType={x:Type UserControl}}}">
        <Expander.Header>
            <DockPanel Height="36" LastChildFill="False">
                <Button s:View.ActionTarget="{Binding DataContext.Parent, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}"
                        DockPanel.Dock="Left"
                        material:ButtonProgressAssist.IsIndeterminate="True"
                        material:ButtonProgressAssist.IsIndicatorVisible="{Binding IsConnectBusy}"
                        material:ButtonProgressAssist.Value="-1"
                        Command="{s:Action ToggleConnectAsync}"
                        CommandParameter="{Binding}"
                        IsEnabled="{Binding CanToggleConnect}">
                    <Button.Style>
                        <Style BasedOn="{StaticResource MaterialDesignProgressToolBarButton}" TargetType="{x:Type ButtonBase}">
                            <Setter Property="ToolTip" Value="Connect"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                    <Setter Property="ToolTip" Value="Disconnect"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                    <material:PackIcon Width="19" Height="19">
                        <material:PackIcon.Style>
                            <Style BasedOn="{StaticResource {x:Type material:PackIcon}}" TargetType="material:PackIcon">
                                <Setter Property="Kind" Value="Play"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Kind" Value="Stop"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </material:PackIcon.Style>
                    </material:PackIcon>
                </Button>

                <ToggleButton DockPanel.Dock="Left"
                              Style="{StaticResource MaterialDesignToolBarToggleButton}"
                              IsChecked="{Binding AutoConnectEnabled}"
                              ToolTip="Auto-connect">
                    <material:PackIcon Width="20" Height="20" Kind="MotionPlayOutline"/>
                </ToggleButton>

                <material:PopupBox DockPanel.Dock="Right"
                                   Style="{StaticResource MaterialDesignToolBarPopupBox}"
                                   PlacementMode="BottomAndAlignRightEdges"
                                   StaysOpen="True"
                                   ToolTip="Update settings">
                    <material:PopupBox.ToggleContent>
                        <material:PackIcon Width="20" Height="20" Kind="TimerCogOutline"/>
                    </material:PopupBox.ToggleContent>
                    <StackPanel Width="250" Margin="10 0 10 0">
                        <TextBlock FontWeight="Bold" Text="Fixed Update" Typography.Capitals="AllSmallCaps"/>
                        <ContentControl Content="{Binding UpdateContexts[FixedUpdate]}"/>
                    </StackPanel>
                </material:PopupBox>
            </DockPanel>
        </Expander.Header>

        <StackPanel Margin="20">
            <DockPanel Margin="0 0 0 10" IsEnabled="{Binding IsDisconnected}" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left" Margin="0 0 10 0" VerticalAlignment="Center" Text="BLE device:"/>
                <ComboBox DockPanel.Dock="Left"
                          ItemsSource="{Binding AvailableDevices}"
                          SelectedItem="{Binding SelectedDevice}"
                          DisplayMemberPath="DisplayName"
                          Width="250"
                          Margin="0 0 10 0"
                          IsEnabled="{Binding IsDisconnected}"/>
                <Button DockPanel.Dock="Left"
                        Style="{StaticResource MaterialDesignOutlinedButton}"
                        Padding="10 2"
                        Click="{s:Action OnRefreshDevices}"
                        ToolTip="Scan for UFO-TW BLE devices">
                    <StackPanel Orientation="Horizontal">
                        <material:PackIcon Width="16" Height="16" Margin="0 0 5 0" Kind="Refresh"/>
                        <TextBlock Text="Refresh"/>
                    </StackPanel>
                </Button>
            </DockPanel>

            <DockPanel Margin="0 0 0 10" IsEnabled="{Binding IsDisconnected}" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left"
                           Margin="0 0 10 0"
                           VerticalAlignment="Center"
                           Text="Genuine protocol:"/>
                <ToggleButton DockPanel.Dock="Left"
                              Width="190"
                              Padding="8 2"
                              IsChecked="{Binding IsGenuineUfoTw}"
                              IsEnabled="{Binding IsDisconnected}">
                    <ToggleButton.Style>
                        <Style BasedOn="{StaticResource MaterialDesignPaperButton}" TargetType="{x:Type ToggleButton}">
                            <Setter Property="Content" Value="False — compatibility firmware"/>
                            <Style.Triggers>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter Property="Content" Value="True — genuine UFO-TW"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </ToggleButton.Style>
                </ToggleButton>
            </DockPanel>

            <TextBlock Margin="0 0 0 20"
                       Foreground="{DynamicResource MaterialDesignBodyLight}"
                       Text="Direct Windows BLE connection; Intiface is not required. Set True for a genuine UFO-TW or False for the compatibility firmware. Pause from any MFP media source sends one stop command; playback resume restores the current Lnip/Rnip command."
                       TextWrapping="Wrap"/>

            <DockPanel Margin="0 0 0 4" LastChildFill="False">
                <TextBlock DockPanel.Dock="Left"
                           VerticalAlignment="Center"
                           FontWeight="Bold"
                           Text="Manual test output"
                           Typography.Capitals="AllSmallCaps"/>
                <Button DockPanel.Dock="Right"
                        Margin="12 0 0 0"
                        Padding="8 2"
                        Click="{s:Action ResetTestValues}"
                        ToolTip="Reset both test sliders to 50%">
                    <StackPanel Orientation="Horizontal">
                        <material:PackIcon Width="15" Height="15" Margin="0 0 4 0" Kind="Restore"/>
                        <TextBlock Text="Reset 50%"/>
                    </StackPanel>
                </Button>
            </DockPanel>
            <TextBlock Margin="0 0 0 8"
                       Foreground="{DynamicResource MaterialDesignBodyLight}"
                       Text="The single-point slider is a speed test control: 50% = stop, below 50% = reverse, above 50% = forward."
                       TextWrapping="Wrap"/>
            <ItemsControl ItemsSource="{Binding UfoAxisControls}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Margin="0 0 -13 0" Columns="2" IsItemsHost="True"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="0 0 20 4" LastChildFill="True">
                            <ToggleButton DockPanel.Dock="Left"
                                          Width="38"
                                          Height="20"
                                          Padding="0"
                                          VerticalAlignment="Center"
                                          IsChecked="{Binding Settings.Enabled}"
                                          IsEnabled="{Binding DataContext.IsDisconnected, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type UserControl}}}">
                                <ToggleButton.Resources>
                                    <Style BasedOn="{StaticResource MaterialDesignPaperButton}" TargetType="{x:Type ToggleButton}">
                                        <Setter Property="material:ElevationAssist.Elevation" Value="Dp0"/>
                                        <Style.Triggers>
                                            <Trigger Property="IsChecked" Value="True">
                                                <Setter Property="Background" Value="{DynamicResource PrimaryHueMidBrush}"/>
                                                <Setter Property="Foreground" Value="{DynamicResource PrimaryHueMidForegroundBrush}"/>
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </ToggleButton.Resources>
                                <TextBlock FontSize="10" FontWeight="Bold" Text="{Binding Name}"/>
                            </ToggleButton>

                            <ToggleButton DockPanel.Dock="Left"
                                          Margin="4 0 4 0"
                                          Padding="5 0"
                                          VerticalAlignment="Center"
                                          Content="TEST"
                                          IsChecked="{Binding TestEnabled}"
                                          IsEnabled="{Binding Settings.Enabled}"
                                          ToolTip="Use the manual test value instead of funscript output"/>

                            <Button DockPanel.Dock="Right"
                                    s:View.ActionTarget="{Binding}"
                                    Width="24"
                                    Height="20"
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    Click="{s:Action Reset}"
                                    ToolTip="Reset this test value to 50%">
                                <material:PackIcon Width="15" Height="15" Kind="Restore"/>
                            </Button>

                            <TextBlock DockPanel.Dock="Right"
                                       Width="42"
                                       VerticalAlignment="Center"
                                       TextAlignment="Right"
                                       Text="{Binding TestValue, StringFormat={}{0:P0}}"/>

                            <Slider Margin="6 0 6 0"
                                    VerticalAlignment="Center"
                                    IsEnabled="{Binding TestEnabled}"
                                    Maximum="1"
                                    Minimum="0"
                                    ToolTip="{Binding TestValue, StringFormat={}{0:P0}}"
                                    Value="{Binding TestValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        </DockPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </Expander>
</UserControl>
