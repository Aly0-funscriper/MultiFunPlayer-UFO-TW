<UserControl x:Class="MultiFunPlayer.UI.Dialogs.Views.PluginDialog"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:material="http://materialdesigninxaml.net/winfx/xaml/themes"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:s="https://github.com/canton7/Stylet"
             d:DesignHeight="450"
             d:DesignWidth="800"
             x:ClassModifier="internal"
             mc:Ignorable="d">
    <Grid s:View.ActionTarget="{Binding PluginInstance}"
          MinWidth="100"
          Margin="20">
        <Button DockPanel.Dock="Top"
                Style="{StaticResource MaterialDesignFlatButton}"
                Width="24"
                Height="24"
                Margin="0 -15 -15 0"
                Padding="0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                material:RippleAssist.Feedback="{DynamicResource MaterialDesignBody}"
                Command="{x:Static material:DialogHost.CloseDialogCommand}"
                Foreground="{DynamicResource MaterialDesignBody}">
            <material:PackIcon Width="20"
                               Height="20"
                               Kind="Close"/>
        </Button>

        <ContentPresenter Content="{Binding View}"/>
    </Grid>
</UserControl>
